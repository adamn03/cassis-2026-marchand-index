# Secrets — never commit
.env
*.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# HTTP cache (regenerable) — match the cache dir wherever it lives (post-2026-06-28 reorg moved
# pilot/ -> "Pilot Files/pilot/" and marchand_index/ -> "Full Project Files/marchand_index/")
**/cache/
**/requests_cache.sqlite
**/http_cache*

# Atomic-write leftovers
*.tmp

# Pandoc HTML intermediates (final PDFs ARE committed)
*.html

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code settings (user-specific permissions/hooks)
.claude/

# Logs
*.log

# PDF build artifacts (the final abstract_final.pdf IS committed)
*.aux
*.out
*.toc
*.synctex.gz

# Generated deliverable snapshot. `final_dataset/` is a copy of marchand_index/raw/
# built by `python export_final_dataset.py`; committing it duplicated every data
# change and drifted out of sync (trends.csv, 34 rows, caught 2026-08-26).
# The authored README stays tracked; the copied data does not.
Full Project Files/final_dataset/**
!Full Project Files/final_dataset/README.md

# Run logs (moved out of the package root into logs/ on 2026-08-26)
**/logs/

# Local backups / quarantined data — keep these OUTSIDE the repo
backup_*/

# superseded pilot: code removed 2026-08-31, local venv/cache left on disk
"Pilot Files"/
"Dashboard Inspo"/
marchand_index/dashboard/

# the published dashboard is a deliverable, not a scratch html file
!docs/index.html
