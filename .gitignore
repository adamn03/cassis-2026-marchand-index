# Secrets — never commit
.env
*.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# HTTP cache (regenerable)
pilot/cache/
marchand_index/cache/
**/requests_cache.sqlite
**/http_cache*

# Atomic-write leftovers
*.tmp

# Pandoc HTML intermediates (final PDFs ARE committed)
*.html

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code settings (user-specific permissions/hooks)
.claude/

# Logs
*.log

# PDF build artifacts (the final abstract_final.pdf IS committed)
*.aux
*.out
*.toc
*.synctex.gz
